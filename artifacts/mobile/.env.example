# Copy this file to `.env` in this folder (artifacts/mobile). Expo reads env files from the
# mobile package root, not the monorepo root. EXPO_PUBLIC_* values are inlined into the JS
# bundle at publish/build time — they are PUBLIC BY DESIGN (they ship inside the app), which
# is why real production values appear here. Real secrets never belong in this file.

# API server (Dexcom proxy, doctor sync, food AI). Production:
EXPO_PUBLIC_API_BASE_URL=https://api.glucoseguardian.io

# Convex PROD deployment (patient auth + data — what live users run):
EXPO_PUBLIC_CONVEX_URL=https://polished-badger-189.convex.cloud

# Clerk publishable key — public by design (ships in the binary). The SECRET key is never
# needed in this project: Convex verifies tokens against Clerk's public JWKS.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmV4dC1vc3ByZXktMTUuY2xlcmsuYWNjb3VudHMuZGV2JA
